{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "docs/plan/tpm.schema.json",
  "title": "cwht MOPs, TPMs and leading indicators (docs/plan/tpm.json)",
  "description": "Schema owned by the SEMP (docs/plan/semp.md sections 4.3 and 7.4; docs/process/02-requirements-and-traceability.md section 6.2). Covers the conventions block, mops[] with the 02 section 6.2 fields, and tpms[] with id and key patterns, required fields, the tbr object, the planned_value/tbr rule and the history entry shape. Cross-item rules that JSON Schema cannot express (unique ids and keys, mop_id resolution, tpm_ids back-references, every MOE covered by a MOP) are checked by tools/traceability.py rule T-16 and by the SEMP section 7.4 cross-check.",
  "type": "object",
  "required": ["title", "schema", "version", "governing", "conventions", "mops", "tpms"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "schema": {"const": "docs/plan/tpm.schema.json"},
    "version": {"type": "string", "minLength": 1},
    "governing": {
      "type": "object",
      "required": ["semp_section", "charter_sections", "npr_7123_1d"],
      "properties": {
        "semp_section": {"type": "string"},
        "charter_sections": {"type": "array", "items": {"type": "string"}},
        "decision_records": {"type": "array", "items": {"type": "string", "pattern": "^ADR-[0-9]{3} "}},
        "process_documents": {"type": "array", "items": {"type": "string"}},
        "npr_7123_1d": {"type": "array", "items": {"type": "string", "pattern": "^SE-[0-9]{2} "}},
        "se_handbook": {"type": "array", "items": {"type": "string", "pattern": "^SE HB "}}
      },
      "additionalProperties": false
    },
    "conventions": {
      "type": "object",
      "required": [
        "id_patterns",
        "owner_of_all_measures",
        "mop_rule",
        "reporting_interval",
        "status_note",
        "status_rule",
        "margin_definition",
        "tbr_rule",
        "evidence_rules",
        "history_entry_shape",
        "key_rule",
        "schema_rule",
        "instruments"
      ],
      "properties": {
        "id_patterns": {
          "type": "object",
          "required": ["mop", "tpm"],
          "properties": {
            "mop": {"const": "^MOP-[0-9]{3}$"},
            "tpm": {"const": "^TPM-[0-9]{3}$"}
          },
          "additionalProperties": false
        },
        "history_entry_shape": {
          "type": "object",
          "required": ["review", "date", "cbe", "status", "evidence", "credit"],
          "additionalProperties": {"type": "string"}
        }
      },
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "mops": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/mop"}
    },
    "tpms": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/tpm"}
    }
  },
  "definitions": {
    "review_token": {
      "type": "string",
      "enum": ["SRR", "PDR", "CDR", "TRR", "TRR-Dn", "SAR"],
      "description": "Gate tokens of charter section 6; TRR-Dn stands for every delta TRR in reporting_review and margin_policy"
    },
    "moe_id": {"type": "string", "pattern": "^MOE-[0-9]{3}$"},
    "mop_id": {"type": "string", "pattern": "^MOP-[0-9]{3}$"},
    "tpm_id": {"type": "string", "pattern": "^TPM-[0-9]{3}$"},
    "req_id": {"type": "string", "pattern": "^REQ-(SYS|RX|TX|PWR|CTL|ME|SW|SW-[A-Z0-9]+)-[0-9]{3}$"},
    "tc_id": {"type": "string", "pattern": "^TC-(SYS|RX|TX|PWR|CTL|ME|SW|SW-[A-Z0-9]+|VAL|ATP|SW-COV|SW-REG|SW-TOOL)-[0-9]{3}$"},
    "mop": {
      "type": "object",
      "required": ["id", "title", "moe_ids", "requirement_ids", "unit", "threshold", "target", "tc_ids", "tpm_ids"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/definitions/mop_id"},
        "title": {"type": "string", "minLength": 1},
        "moe_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/moe_id"}},
        "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/req_id"}},
        "unit": {"type": "string", "minLength": 1},
        "threshold": {"type": "string", "minLength": 1, "description": "Minimum acceptable value (02 section 6.2)"},
        "target": {"type": "string", "minLength": 1},
        "tc_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/tc_id"}},
        "tpm_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/tpm_id"}},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "tbr": {
      "type": "object",
      "required": ["owner", "plan", "close_by"],
      "additionalProperties": false,
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "plan": {"type": "string", "minLength": 1},
        "close_by": {"type": "string", "enum": ["SRR", "PDR", "CDR", "TRR", "SAR"]}
      }
    },
    "history_entry": {
      "type": "object",
      "required": ["review", "date", "cbe", "status", "evidence", "credit"],
      "additionalProperties": true,
      "description": "conventions.history_entry_shape; additional per-TPM fields are allowed (tpm_specific)",
      "properties": {
        "review": {"type": "string", "pattern": "^(SRR|PDR|CDR|TRR|SAR|TRR-D[1-9][0-9]?|status-[0-9]{4}-[0-9]{2}-[0-9]{2})$"},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "cbe": {"type": ["number", "null"]},
        "status": {"type": "string", "enum": ["green", "yellow", "red"]},
        "evidence": {"type": "string", "minLength": 1},
        "credit": {"type": "boolean"},
        "note": {"type": "string"}
      }
    },
    "tpm": {
      "type": "object",
      "required": [
        "id",
        "key",
        "name",
        "category",
        "npr_ref",
        "mop_id",
        "definition",
        "units",
        "formula",
        "data_source",
        "planned_value",
        "planned_value_text",
        "tbr",
        "margin_policy",
        "threshold_yellow",
        "threshold_red",
        "measurement_method",
        "reporting_review",
        "moe_ids",
        "requirement_ids",
        "history"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/definitions/tpm_id"},
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "description": "Stable machine key; never changes once reported (conventions.key_rule)"},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["leading_indicator", "project"]},
        "npr_ref": {"type": "string", "pattern": "^SE-[0-9]{2}"},
        "mop_id": {"oneOf": [{"$ref": "#/definitions/mop_id"}, {"type": "null"}]},
        "mop_note": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "units": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1},
        "data_source": {"type": "string", "minLength": 1},
        "planned_value": {"type": ["number", "null"]},
        "planned_value_text": {"type": "string", "minLength": 1},
        "tbr": {"oneOf": [{"$ref": "#/definitions/tbr"}, {"type": "null"}]},
        "margin_policy": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"enum": ["SRR", "PDR", "CDR", "TRR", "TRR-Dn", "SAR", "every_review"]},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "threshold_yellow": {"type": "string", "minLength": 1},
        "threshold_red": {"type": "string", "minLength": 1},
        "measurement_method": {
          "type": "object",
          "required": ["pre_build", "post_build"],
          "additionalProperties": false,
          "properties": {
            "pre_build": {"type": "string", "minLength": 1},
            "post_build": {"type": "string", "minLength": 1}
          }
        },
        "reporting_review": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/review_token"}},
        "moe_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/moe_id"}},
        "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/req_id"}},
        "history": {"type": "array", "items": {"$ref": "#/definitions/history_entry"}}
      },
      "allOf": [
        {
          "description": "A TPM without a MOP is a process or design-margin indicator and says why (conventions.mop_rule)",
          "if": {"properties": {"mop_id": {"type": "null"}}, "required": ["mop_id"]},
          "then": {"required": ["mop_note"]}
        },
        {
          "description": "planned_value is null while a TBR is open, and a number when no TBR is open (conventions.tbr_rule)",
          "if": {"properties": {"tbr": {"type": "object"}}, "required": ["tbr"]},
          "then": {"properties": {"planned_value": {"type": "null"}}},
          "else": {"properties": {"planned_value": {"type": "number"}}}
        }
      ]
    }
  }
}
