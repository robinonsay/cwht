{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fixture hazard list",
  "type": "object",
  "required": ["hazards"],
  "properties": {
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "requirement_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^HZ-[0-9]{3}$"},
          "title": {"type": "string"},
          "severity": {"type": "string", "enum": ["Catastrophic", "Critical", "Marginal", "Negligible"]},
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text", "control_req_ids"],
              "properties": {
                "id": {"type": "string"},
                "text": {"type": "string"},
                "control_req_ids": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "requirement_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
