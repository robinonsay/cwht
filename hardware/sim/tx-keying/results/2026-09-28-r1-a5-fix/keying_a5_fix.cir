.param DB=table(run,1,2.23607,2,2.23607,3,2.23607,4,2.23607,5,2.23607,6,2.23607,7,1,8,1,9,1,10,1,11,1,12,1,13,2.23607,14,2.23607,15,2.23607,16,2.23607,17,2.23607,18,2.23607,19,1,20,1,21,1,22,1,23,1,24,1,25,2.23607,26,2.23607,27,2.23607,28,2.23607,29,2.23607,30,2.23607,31,1,32,1,33,1,34,1,35,1,36,1,37,2.23607,38,2.23607,39,2.23607,40,2.23607,41,2.23607,42,2.23607,43,1,44,1,45,1,46,1,47,1,48,1,49,2.23607,50,2.23607,51,2.23607,52,2.23607,53,2.23607,54,2.23607,55,1,56,1,57,1,58,1,59,1,60,1,61,2.23607,62,2.23607,63,2.23607,64,2.23607,65,2.23607,66,2.23607,67,1,68,1,69,1,70,1,71,1,72,1,73,2.23607,74,2.23607,75,2.23607,76,2.23607,77,2.23607,78,2.23607,79,1,80,1,81,1,82,1,83,1,84,1,85,2.23607,86,2.23607,87,2.23607,88,2.23607,89,2.23607,90,2.23607,91,1,92,1,93,1,94,1,95,1,96,1,97,2.23607,98,2.23607,99,2.23607,100,2.23607,101,2.23607,102,2.23607,103,1,104,1,105,1,106,1,107,1,108,1)
.param PLEAK=1.99526e-05
.param LOSS=0.891251 KDIV=0.654 KTRIM=0.16 KFF=1.0
.step param run 1 108 1
.func tm(x) {x-TPER*floor(x/TPER)}
.func rc(u) {if(u<TLEAD,0,if(u<TLEAD+TR,0.5*(1-cos(pi*(u-TLEAD)/TR)),if(u<TLEAD+TDIT,1,if(u<TE,0.5*(1+cos(pi*(u-TLEAD-TDIT)/TR)),0))))}
.func env(x) {rc(tm(floor(x/TQ)*TQ))}
.func wnd(u,a,b) {(u>=a)*(u<b)}
.func onw(x,a,b) {max(wnd(tm(x),a,b),(x>=TPER)*wnd(tm(x)+TPER,a,b))}
V5 v5 0 5
* firmware reference: raised-cosine amplitude table predistorted by the detector law (table of
* run 2026-09-28-det-char-biased), 12-bit PWM updated every 32.768 us, 2-pole RC
* DB: detector tap factor (1, or BOOST at the 0.5 and 1 W steps of the revision 1 design)
Bref refraw 0 V=table(DB*ASET*env(time),-1,0,0,0,0.05,8.27946e-05,0.1,0.000330664,0.2,0.00131475,0.35,0.00396146,0.6,0.0111292,1,0.0278097,1.7,0.0647408,3,0.142508,5,0.270735,9,0.536205,15,0.943429,22.36,1.44789,28,1.83699)
R1 refraw r1 4.7k
C1 r1 0 10n
R2 r1 vref 4.7k
C2 vref 0 10n
* error amplifier: difference integrator about a 2.5 V mid-rail (bipolar trim), modelled as an ideal
* integrator with rails: V(out) = 2.5 V + integral of (Vref - Vdet + VOS)/(RIN*CF), limited to 0..5 V,
* reset to 2.5 V while parked; it does not load the reference or the detector (buffered inputs, e.g.
* an MCP6002 difference integrator with the spare half as buffer; WP-PDR-22 sets the circuit).
* VOS is the residual input offset after the firmware zero calibration.
* revision 1: the integrator input is opened while parked, so the trim is HELD between elements
* (no reset); it starts at mid-rail at t = 0 (power-on)
Gi 0 xi value={(1-V(park))*(V(vref)-V(detf)+VOS)/10000}
Ci xi 0 4.48e-09
Dih xi vh DI
Dil vl xi DI
Vh vh 0 2.485
Vl vl 0 -2.485
Bo out 0 V=2.5+V(xi)
.model DI D(Ron=1 Roff=1e12 Vfwd=0)
* feedforward VGG table (second 12-bit PWM, same update and 2-pole RC as the reference): the nominal
* inverse PA curve at the run's drain voltage for KFF of the wanted amplitude, 0 V when the table is 0
Bff ffraw 0 V=(env(time)>0)*max(table(10*log10(max((KFF*ASET*env(time))**2/100/LOSS/SCALE,1e-20)*1e3),-279.485,-0.68,-229.485,-0.18,-179.485,0.32,-129.485,0.82,-79.4846,1.32,-29.4846,1.82,20.5154,2.32,21.9368,2.34,23.1848,2.36,24.3838,2.38,25.5509,2.4,26.5753,2.42,27.58,2.44,28.5058,2.46,29.3797,2.48,30.0903,2.5,30.8095,2.52,31.2759,2.54,32.1018,2.56,32.7779,2.58,33.4682,2.6,33.9358,2.62,34.4373,2.64,34.8966,2.66,35.3405,2.68,35.7068,2.7,36.1383,2.72,36.4895,2.74,36.7686,2.76,36.9978,2.78,37.2139,2.8,37.4003,2.82,37.5709,2.84,37.734,2.86,37.8522,2.88,38.0028,2.9,38.1122,2.92,38.2265,2.94,38.3248,2.96,38.4164,2.98,38.4956,3,38.5763,3.02,38.6442,3.04,38.7051,3.06,38.7593,3.08,38.8036,3.1,38.8485,3.12,38.8856,3.14,38.9215,3.16,38.9492,3.18,38.9787,3.2,39.0097,3.22,39.0316,3.24,39.0528,3.26,39.0656,3.28,39.0856,3.3,39.1049,3.32,39.1242,3.34,39.1415,3.36,39.1548,3.38,39.1693,3.4,39.242,3.5,39.3215,3.6,39.4076,3.7,39.4905,3.8,39.5716,3.9),0)
R3 ffraw f1 4.7k
C3 f1 0 10n
R4 f1 ff 4.7k
C4 ff 0 10n
* VGG node: feedforward plus the loop trim, KTRIM volts per volt of the error amplifier about
* mid-rail (+/-0.25 V authority), not below 0 V (Schottky clamp), 1.77 k, 10 nF
Bvt vt 0 V=max(KTRIM*(V(out)-2.5)+V(ff),0)
Rth vt vgg 1770
Cg vgg 0 1e-08
* clamps (open collector, on at reset): VGG node held low and integrator parked outside the window
* ramp start .. drive gate
Bpk park 0 V=1-onw(time,TLEAD,TE+TG)
S1 vgg 0 park 0 SWC
S4 vref 0 park 0 SWC
.model SWC SW(Ron=10 Roff=1e9 Vt=0.5 Vh=0.05)
* PA static transfer (dBm at the reference drain voltage) scaled for the drain voltage, curve shifted
* by VSH (module-to-module threshold corner)
Bpg pg 0 V=SCALE*pow(10,(table(V(vgg)-VSH,-0.68,-279.485,-0.18,-229.485,0.32,-179.485,0.82,-129.485,1.32,-79.4846,1.82,-29.4846,2.32,20.5154,2.34,21.9368,2.36,23.1848,2.38,24.3838,2.4,25.5509,2.42,26.5753,2.44,27.58,2.46,28.5058,2.48,29.3797,2.5,30.0903,2.52,30.8095,2.54,31.2759,2.56,32.1018,2.58,32.7779,2.6,33.4682,2.62,33.9358,2.64,34.4373,2.66,34.8966,2.68,35.3405,2.7,35.7068,2.72,36.1383,2.74,36.4895,2.76,36.7686,2.78,36.9978,2.8,37.2139,2.82,37.4003,2.84,37.5709,2.86,37.734,2.88,37.8522,2.9,38.0028,2.92,38.1122,2.94,38.2265,2.96,38.3248,2.98,38.4164,3,38.4956,3.02,38.5763,3.04,38.6442,3.06,38.7051,3.08,38.7593,3.1,38.8036,3.12,38.8485,3.14,38.8856,3.16,38.9215,3.18,38.9492,3.2,38.9787,3.22,39.0097,3.24,39.0316,3.26,39.0528,3.28,39.0656,3.3,39.0856,3.32,39.1049,3.34,39.1242,3.36,39.1415,3.38,39.1548,3.4,39.1693,3.5,39.242,3.6,39.3215,3.7,39.4076,3.8,39.4905,3.9,39.5716)-30)/10)
* drive gate: CLK1 enable and GVA-84+ bias, 10 us
Bd dr0 0 V=onw(time,TCLK,TE+TG)
Rd dr0 dr 1k
Cd dr 0 10n
* relay pole A contact (closes 7.5 ms after the relay command)
Bc cont 0 V=time>TC
* power and amplitude at the 50 ohm load (after 0.5 dB LPF and relay loss); PLEAK is the output with
* the gate off and the exciter driven (estimate, see the record)
Bpl pl 0 V=V(cont)*V(dr)*(V(pg)+PLEAK)*LOSS
Bal al 0 V=sqrt(100*max(V(pl),0))
* detector static law from run 2026-09-28-det-char-biased and its 4.7 us video pole (10 k, 470 pF);
* DB is the tap factor (the diode sees DB times the amplitude of the 5 W design tap)
Bdet d0 0 V=table(DB*V(al),-1,0,0,0,0.05,8.27946e-05,0.1,0.000330664,0.2,0.00131475,0.35,0.00396146,0.6,0.0111292,1,0.0278097,1.7,0.0647408,3,0.142508,5,0.270735,9,0.536205,15,0.943429,22.36,1.44789,28,1.83699)
Rv d0 detf 1k
Cv detf 0 4.7n
* op-amp macro: gm stage, Aol 112 dB, GBW 1 MHz, internal node and output limited to the rails
.subckt OPA inp inn out vcc
G1 0 x inp inn 1m
Rx x 0 4e8
Cx x 0 159p
Dhi x vcc DI
Dlo 0 x DI
Bo o 0 V=limit(V(x),0.015,V(vcc)-0.015)
Ro o out 20
.model DI D(Ron=1 Roff=1e12 Vfwd=0)
.ends OPA
.save V(al) V(vgg)
.tran 0 0.384 0.0 20u
.options reltol=1e-4
.end
