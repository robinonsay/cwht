.param mcsb21=table(run, 1,1.05708224, 2,1.05708224, 3,1.05708224, 4,1.05708224, 5,1.05708224)
.param mcsb30=table(run, 1,1.0513703, 2,1.0513703, 3,1.0513703, 4,1.0513703, 5,1.0513703)
