.param SGN3=table(run, 1,0, 2,1, 3,1, 4,1, 5,1)
.param mckb10=table(run, 1,1.12452489, 2,1.12452489, 3,1.12452489, 4,1.12452489, 5,1.12452489)
.param mckb20=table(run, 1,1.18708291, 2,1.18708291, 3,1.18708291, 4,0.812917094, 5,0.812917094)
.param mckb21=table(run, 1,1.18708291, 2,1.18708291, 3,1.18708291, 4,0.812917094, 5,0.812917094)
.param mckb30=table(run, 1,1.12452489, 2,1.12452489, 3,1.12452489, 4,1.12452489, 5,1.12452489)
