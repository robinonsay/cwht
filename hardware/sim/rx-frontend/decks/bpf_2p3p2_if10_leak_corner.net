.param CST1=table(run, 1,1e-21, 2,3e-14, 3,3e-14, 4,1e-13, 5,1e-13)
.param CST2=table(run, 1,1e-21, 2,3e-14, 3,3e-14, 4,1e-13, 5,1e-13)
.param CST3=table(run, 1,1e-21, 2,3e-14, 3,3e-14, 4,1e-13, 5,1e-13)
.param QU=table(run, 1,100, 2,100, 3,100, 4,100, 5,100)
.param RL1=table(run, 1,57.3151455, 2,57.3151455, 3,57.3151455, 4,57.3151455, 5,57.3151455)
.param RL2=table(run, 1,57.3151455, 2,57.3151455, 3,57.3151455, 4,57.3151455, 5,57.3151455)
.param RL3=table(run, 1,57.3151455, 2,57.3151455, 3,57.3151455, 4,57.3151455, 5,57.3151455)
.param RS1=table(run, 1,50, 2,50, 3,50, 4,50, 5,50)
