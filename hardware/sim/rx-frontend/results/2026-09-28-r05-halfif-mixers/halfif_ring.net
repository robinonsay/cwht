* cwht receiver: diode-ring mixer (A5) half-IF (2RF - 2LO) response, LO 136 MHz, IF 8 MHz
* Generated by hardware/sim/rx-frontend/make_decks.py. LTspice 26.0.2 via tools/ltspice-batch.sh.
* Transformer windings 4 uH each, k 0.99 (estimate for 2 to 3 trifilar turns on BN-43-202 at VHF, Low).
* LO: Si5351 CLK0, square wave, edges 1 ns (Si5351 datasheet 1 ns typ 20-80 %), duty D (45 to 55 % datasheet),
*     EMF +/-1.571 V behind 50 ohm = +10 dBm fundamental available (TS-012 section 7.3).
.step param run 1 23 1
.param f=table(run, 1,1.44e+08, 2,1.4e+08, 3,1.4e+08, 4,1.4e+08, 5,1.4e+08, 6,1.4e+08, 7,1.4e+08, 8,1.44e+08, 9,1.4e+08, 10,1.4e+08, 11,1.4e+08, 12,1.44e+08, 13,1.4e+08, 14,1.4e+08, 15,1.4e+08, 16,1.44e+08, 17,1.4e+08, 18,1.4e+08, 19,1.4e+08, 20,1.44e+08, 21,1.4e+08, 22,1.4e+08, 23,1.4e+08)
.param p=table(run, 1,-30, 2,-150, 3,-40, 4,-30, 5,-20, 6,-10, 7,0, 8,-30, 9,-20, 10,-10, 11,0, 12,-30, 13,-20, 14,-10, 15,0, 16,-30, 17,-20, 18,-10, 19,0, 20,-30, 21,-20, 22,-10, 23,0)
.param d=table(run, 1,0.5, 2,0.5, 3,0.5, 4,0.5, 5,0.5, 6,0.5, 7,0.5, 8,0.45, 9,0.45, 10,0.45, 11,0.45, 12,0.55, 13,0.55, 14,0.55, 15,0.55, 16,0.45, 17,0.45, 18,0.45, 19,0.45, 20,0.55, 21,0.55, 22,0.55, 23,0.55)
.param m1=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,0.940099, 9,0.940099, 10,0.940099, 11,0.940099, 12,1.1207, 13,1.1207, 14,1.1207, 15,1.1207, 16,0.99293, 17,0.99293, 18,0.99293, 19,0.99293, 20,0.833098, 21,0.833098, 22,0.833098, 23,0.833098)
.param m2=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,0.835991, 9,0.835991, 10,0.835991, 11,0.835991, 12,1.17348, 13,1.17348, 14,1.17348, 15,1.17348, 16,0.917931, 17,0.917931, 18,0.917931, 19,0.917931, 20,0.909725, 21,0.909725, 22,0.909725, 23,0.909725)
.param m3=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,0.945229, 9,0.945229, 10,0.945229, 11,0.945229, 12,0.978146, 13,0.978146, 14,0.978146, 15,0.978146, 16,0.901854, 17,0.901854, 18,0.901854, 19,0.901854, 20,0.807662, 21,0.807662, 22,0.807662, 23,0.807662)
.param m4=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,0.915113, 9,0.915113, 10,0.915113, 11,0.915113, 12,0.827953, 13,0.827953, 14,0.827953, 15,0.827953, 16,0.810547, 17,0.810547, 18,0.810547, 19,0.810547, 20,1.08032, 21,1.08032, 22,1.08032, 23,1.08032)
.param r1=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,1.05694, 9,1.05694, 10,1.05694, 11,1.05694, 12,0.959159, 13,0.959159, 14,0.959159, 15,0.959159, 16,1.08442, 17,1.08442, 18,1.08442, 19,1.08442, 20,0.940042, 21,0.940042, 22,0.940042, 23,0.940042)
.param r2=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,0.900175, 9,0.900175, 10,0.900175, 11,0.900175, 12,1.07958, 13,1.07958, 14,1.07958, 15,1.07958, 16,0.985686, 17,0.985686, 18,0.985686, 19,0.985686, 20,1.09145, 21,1.09145, 22,1.09145, 23,1.09145)
.param r3=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,1.03123, 9,1.03123, 10,1.03123, 11,1.03123, 12,0.941346, 13,0.941346, 14,0.941346, 15,0.941346, 16,1.0787, 17,1.0787, 18,1.0787, 19,1.0787, 20,0.972908, 21,0.972908, 22,0.972908, 23,0.972908)
.param r4=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,0.963917, 9,0.963917, 10,0.963917, 11,0.963917, 12,1.05208, 13,1.05208, 14,1.05208, 15,1.05208, 16,0.987747, 17,0.987747, 18,0.987747, 19,0.987747, 20,0.988284, 21,0.988284, 22,0.988284, 23,0.988284)
.param c1=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,1.00287, 9,1.00287, 10,1.00287, 11,1.00287, 12,0.957271, 13,0.957271, 14,0.957271, 15,0.957271, 16,0.944266, 17,0.944266, 18,0.944266, 19,0.944266, 20,1.01472, 21,1.01472, 22,1.01472, 23,1.01472)
.param c2=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,1.00788, 9,1.00788, 10,1.00788, 11,1.00788, 12,0.964572, 13,0.964572, 14,0.964572, 15,0.964572, 16,0.908063, 17,0.908063, 18,0.908063, 19,0.908063, 20,1.03593, 21,1.03593, 22,1.03593, 23,1.03593)
.param c3=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,1.03715, 9,1.03715, 10,1.03715, 11,1.03715, 12,0.92974, 13,0.92974, 14,0.92974, 15,0.92974, 16,1.02946, 17,1.02946, 18,1.02946, 19,1.02946, 20,0.902353, 21,0.902353, 22,0.902353, 23,0.902353)
.param c4=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,1.00303, 9,1.00303, 10,1.00303, 11,1.00303, 12,1.09546, 13,1.09546, 14,1.09546, 15,1.09546, 16,0.993071, 17,0.993071, 18,0.993071, 19,0.993071, 20,0.956414, 21,0.956414, 22,0.956414, 23,0.956414)
.param lb=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,1.00685, 9,1.00685, 10,1.00685, 11,1.00685, 12,1.002, 13,1.002, 14,1.002, 15,1.002, 16,0.991558, 17,0.991558, 18,0.991558, 19,0.991558, 20,0.994654, 21,0.994654, 22,0.994654, 23,0.994654)
.param lc=table(run, 1,1, 2,1, 3,1, 4,1, 5,1, 6,1, 7,1, 8,0.987577, 9,0.987577, 10,0.987577, 11,0.987577, 12,0.987525, 13,0.987525, 14,0.987525, 15,0.987525, 16,1.00334, 17,1.00334, 18,1.00334, 19,1.00334, 20,1.00544, 21,1.00544, 22,1.00544, 23,1.00544)
.param FLO=136Meg TLO={1/FLO} TR=1n
.param VRF={sqrt(400*10**(p/10-3))}
Vrf srf 0 SINE(0 {VRF} {f})
Rrf srf rf 50
Vlo slo 0 PULSE(-1.571 1.571 0 {TR} {TR} {d*TLO-TR} {TLO})
Rlo slo lo 50
* RF transformer T1: primary rf-0, secondary a-ct1-b
L1a rf 0 4u Rser=0.05
L1b a ct1 {4u*lb} Rser=0.05
L1c ct1 b {4u*lc} Rser=0.05
K1 L1a L1b L1c 0.99
* LO transformer T2: primary lo-0, secondary c-0(ct)-d
L2a lo 0 4u Rser=0.05
L2b c 0 4u Rser=0.05
L2c 0 d 4u Rser=0.05
K2 L2a L2b L2c 0.99
* ring
D1 a c DM1
D2 c b DM2
D3 b d DM3
D4 d a DM4
* IF port: RF-transformer centre tap into 50 ohm
Rif ct1 0 50
.model DM1 D(IS={19.7n*m1} N=1.51 BV=70 IBV=50n RS={6.27*r1} CJO={1.8p*c1} VJ=.75 M=.333 XTI=2 EG=.69 TT=10.8p)
.model DM2 D(IS={19.7n*m2} N=1.51 BV=70 IBV=50n RS={6.27*r2} CJO={1.8p*c2} VJ=.75 M=.333 XTI=2 EG=.69 TT=10.8p)
.model DM3 D(IS={19.7n*m3} N=1.51 BV=70 IBV=50n RS={6.27*r3} CJO={1.8p*c3} VJ=.75 M=.333 XTI=2 EG=.69 TT=10.8p)
.model DM4 D(IS={19.7n*m4} N=1.51 BV=70 IBV=50n RS={6.27*r4} CJO={1.8p*c4} VJ=.75 M=.333 XTI=2 EG=.69 TT=10.8p)
.save V(ct1)
* Max step 10 ps: the time-step error leaves a response proportional to the input at 8 MHz (a numerical
* floor): -81 dBc at 20 ps and -86 dBc at 5 ps, independent of reltol 1e-6 or 1e-8 (scratch test 2026-09-28).
.tran 0 1.25u 1u 10p
.options plotwinsize=0 numdgt=15 reltol=1e-6 abstol=1e-15 vntol=1e-9
.end
