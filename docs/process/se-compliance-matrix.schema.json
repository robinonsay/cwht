{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cwht NPR 7123.1D compliance matrix (App. H, Table H-1)",
  "description": "Structure of docs/process/se-compliance-matrix.json. One row per Table H-1 requirement with the six App. H.1.1 contents (identifier, paragraph reference, verbatim requirement statement, verbatim rationale, Comply?, Justification) plus the cwht implementation reference. Comply codes per App. H.1.3: FC, T, NA. A T row carries relief_type and risk_evaluation (NPR 7123.1D sections 2.2.1.2 and 2.2.1.3); relief_type is allowed on T rows only. T and NA justifications are at least 40 characters. The row set, row order, paragraph references and verbatim texts are cross-checked against docs/references/md/npr-7123-1d/14-appendixh.md by tools/render_compliance.py, which also enforces the dispositions fixed by charter section 12.",
  "type": "object",
  "required": [
    "title",
    "status",
    "revision_date",
    "source",
    "governing_tailoring",
    "comply_codes",
    "field_notes",
    "approval",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "revision_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date of the last content change; printed in the render so that re-rendering unchanged JSON is byte-identical"
    },
    "source": { "type": "string", "minLength": 1 },
    "governing_tailoring": { "type": "string", "minLength": 1 },
    "comply_codes": {
      "type": "object",
      "required": ["FC", "T", "NA"],
      "additionalProperties": false,
      "properties": {
        "FC": { "type": "string", "minLength": 1 },
        "T": { "type": "string", "minLength": 1 },
        "NA": { "type": "string", "minLength": 1 }
      }
    },
    "field_notes": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "approval": {
      "type": "object",
      "required": ["submitted_by", "approved_by", "approval_memo"],
      "additionalProperties": false,
      "properties": {
        "submitted_by": { "type": "string", "minLength": 1 },
        "approved_by": { "type": ["string", "null"] },
        "approval_memo": { "type": "string", "minLength": 1 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/row" }
    }
  },
  "definitions": {
    "row": {
      "type": "object",
      "required": [
        "se_id",
        "npr_section",
        "requirement_statement",
        "rationale",
        "comply",
        "justification",
        "implementation_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "se_id": { "type": "string", "pattern": "^SE-[0-9]{2}$" },
        "npr_section": { "type": "string", "minLength": 1 },
        "requirement_statement": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "short_form": { "type": "string", "minLength": 1 },
        "comply": { "enum": ["FC", "T", "NA"] },
        "justification": { "type": "string" },
        "relief_type": { "enum": ["deviation", "waiver"] },
        "risk_evaluation": { "type": "string", "minLength": 20 },
        "implementation_ref": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "required": ["comply"], "properties": { "comply": { "enum": ["T", "NA"] } } },
          "then": { "properties": { "justification": { "minLength": 40 } } },
          "else": { "properties": { "justification": { "minLength": 1 } } }
        },
        {
          "if": { "required": ["comply"], "properties": { "comply": { "const": "T" } } },
          "then": { "required": ["relief_type", "risk_evaluation"] },
          "else": { "properties": { "relief_type": false } }
        }
      ]
    }
  }
}
