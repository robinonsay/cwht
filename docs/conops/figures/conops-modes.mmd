%% Source of conops-modes.png; render: mmdc -i conops-modes.mmd -o conops-modes.png -b white -s 2
%% Edges that start on the "Radio on" box apply to every mode inside it.
flowchart TB
    START(( )) -->|delivered| OFF
    OFF["Off"]
    CHG["Charging<br/>(switch off, USB present)"]
    FS["Fault-safe (latched)"]
    FWU["Firmware-update"]
    subgraph ON["Radio on (switch on). From every mode inside: T17 latched fault to Fault-safe, T18 controller reset to Self-test, T19 switch off, T20 power-down"]
        direction TB
        ST["Self-test"]
        RX["Receive<br/>flags GUEST, PRACTICE, USB, LOWBATT<br/>inhibits KEY, HOT, GUARD"]
        TX["Transmit-keyed"]
        TU["Tune"]
        BT["Bench-test"]
        ST -->|T08 pass| RX
        RX <-->|"T10 key, Arm / T11 hang or inhibit"| TX
        RX <-->|"T12 menu, Arm / T13 timeout or inhibit"| TU
        RX <-->|"T14 test menu / T15 exit or inhibit"| BT
    end
    OFF -->|T02 USB in| CHG
    CHG -->|T04 USB out| OFF
    OFF -->|T01 switch on| ST
    CHG -->|T05 switch on| ST
    OFF -->|T03 USB in, BOOTSEL| FWU
    CHG -->|T07 host command| FWU
    RX -->|T16 host command| FWU
    FWU -->|T21 reset, switch on| ST
    FWU -->|T22 reset, switch off| CHG
    FWU -->|T23 power removed| OFF
    ST -->|T09 check fails| FS
    CHG -->|T06 cell or charger fault| FS
    ON -->|T17 latched fault| FS
    ON -->|T19, T20 no USB| OFF
    ON -->|T19, T20 USB| CHG
    FS -->|T24 acknowledged| ST
    FS -->|T25 switch off| OFF
    FS -->|T25 switch off, USB| CHG
    classDef mode fill:#eef3fb,stroke:#3b5b8c,color:#111;
    classDef latched fill:#fbeeee,stroke:#8c3b3b,color:#111;
    class OFF,CHG,FWU,ST,RX,TX,TU,BT mode;
    class FS latched;
    style ON fill:#fafaf2,stroke:#777,color:#111;
