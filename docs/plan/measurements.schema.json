{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "docs/plan/measurements.schema.json",
  "title": "cwht software measurement repository (docs/plan/measurements.json)",
  "description": "Format cwht-measurements-1 of docs/process/07-software-engineering-plan.md section 11.1 (SWE-090 repository; SWE-089 roll-up of section 10.3). Encodes the section 11.1 field table and the per-record rules JSON Schema can express. Rules it cannot express (append-only order, current value per id and scope, supersedes resolution, evidence hash equal to the committed file) are checked by tools/measurements.py when it exists (07 section 11.1).",
  "type": "object",
  "required": [
    "schema",
    "updated",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cwht-measurements-1"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "description": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/record"
      }
    }
  },
  "definitions": {
    "number_or_bool": {
      "type": [
        "number",
        "boolean"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "state",
        "value",
        "unit",
        "scope",
        "build",
        "commit",
        "date",
        "source",
        "credit",
        "sprint",
        "gate",
        "assessment",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MSR-[0-9]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "Measured",
            "Not yet measured"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": [
                "number",
                "boolean"
              ]
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": [
                  "number",
                  "boolean"
                ]
              }
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "pattern": "^(FW-v[0-9]+\\.[0-9]+\\.[0-9]+(-rc[0-9]+)?|FW-B[0-9]+ development build|n/a)$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^ ]+ sha256=[0-9a-f]{64}$"
          }
        },
        "credit": {
          "type": "boolean"
        },
        "sprint": {
          "type": "string",
          "pattern": "^(SW-[0-9]{2}-[A-Za-z0-9-]+|SRR-prep|FW-B[0-9]+|[A-Z]+-prep)$"
        },
        "gate": {
          "type": "string",
          "pattern": "^(SRR|PDR|CDR|TRR|SAR|TRR-D[1-9][0-9]?)$"
        },
        "assessment": {
          "enum": [
            "Green",
            "Yellow",
            "Red",
            "Not assessed"
          ]
        },
        "due": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "scope",
            "date"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^MSR-[0-9]{2}$"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "Measured"
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "Not yet measured"
              }
            }
          },
          "then": {
            "required": [
              "due"
            ],
            "properties": {
              "value": {
                "type": "null"
              },
              "credit": {
                "const": false
              },
              "assessment": {
                "const": "Not assessed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "MSR-05",
                  "MSR-20",
                  "MSR-21"
                ]
              },
              "state": {
                "const": "Measured"
              },
              "date": {
                "not": {
                  "const": "2026-09-25"
                }
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "pattern": "^INSP-[0-9]{3} "
              }
            }
          }
        }
      ]
    }
  }
}
