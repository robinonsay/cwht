          "$ref": "#/definitions/status"
        },
        "note": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Identified",
        "Controls proposed",
        "Controls allocated",
        "Controls verified",
        "Accepted",
        "Retired"
      ],
      "description": "Identified = hazard written, controls not yet proposed; Controls proposed = PHA state (this file at SRR); Controls allocated = every control has control_req_ids (PDR); Controls verified = every control requirement Verified (SAR); Accepted = owner accepted the residual in a decision memo; Retired = hazard no longer applies, rationale kept"
    },
    "hazard": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "exposed",
        "phases",
        "causes",
        "effects",
        "severity",
        "likelihood",
        "initial_risk",
        "rationale",
        "firmware_role",
        "swe134_items",
        "controls",
        "requirement_ids",
        "residual_risk",
        "verification_note",
        "single_point_failures",
        "fault_tolerance",
        "status",
        "related_risk_ids",
        "stakeholder_input_ids",
        "decisions_pending",
        "sources",
        "history"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HZ-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "maxLength": 110,
          "description": "Short noun phrase naming the hazard (the condition, not the accident)"
        },
        "description": {
          "type": "string",
          "minLength": 60,
          "description": "Scenario: the hazardous condition, the energy or agent, the exposure geometry and the thresholds or modes that matter (SWEHB 5.24 item 1)"
        },
        "exposed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "Operator",
              "Guest",
              "Bystander",
              "Household member",
              "Other radio service",
              "Test operator",
              "Property"
            ]
          },
          "description": "Who or what is harmed. Operator = the operating licensee (occupational tier, SI-030); Guest = an unlicensed person handling or keying the unit as a third party; Bystander = any other nearby person (general population); Other radio service = users of a victim service"
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "Transmit",
              "Tune",
              "Receive",
              "Charging",
              "Firmware load",
              "Handling",
              "Storage",
              "Assembly",
              "Bench test"
            ]
          }
        },
        "causes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/cause"
          }
        },
        "effects": {
          "type": "string",
          "minLength": 40,
          "description": "Worst credible consequence with the quantities that set the severity"
        },
        "severity": {
          "$ref": "#/definitions/severity"
        },
        "likelihood": {
          "$ref": "#/definitions/likelihood",
          "description": "Likelihood in the uncontrolled state (baseline architecture without the listed controls), against the fleet horizon of section 3.3"
        },
        "initial_risk": {
          "$ref": "#/definitions/risk_level",
          "description": "risk_matrix[severity][likelihood]; enforced by this schema"
        },
        "rationale": {
          "type": "string",
          "minLength": 60,
          "description": "Why this severity and this likelihood, naming the evidence and its confidence"
        },
        "firmware_role": {
          "type": "object",
          "description": "SWE-205 determination input for this hazard",
          "required": [
            "criteria",
            "statement",
            "safety_critical",
            "components"
          ],
          "additionalProperties": false,
          "properties": {
            "criteria": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/criterion"
              },
              "description": "Empty when firmware plays no safety role in this hazard"
            },
            "statement": {
              "type": "string",
              "minLength": 5
            },
            "safety_critical": {
              "type": "boolean",
              "description": "true when criteria is non-empty and the named components are therefore safety-critical for this hazard"
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 3
              },
              "description": "Firmware components (docs/process/03-software-classification-and-rmm.md section 4.3 names; mission-critical components marked as such)"
            }
          }
        },
        "swe134_items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/swe134_item"
          },
          "description": "SWE-134 items a to l that the firmware controls of this hazard implement (empty when no firmware role)"
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/control"
          }
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/req_id"
          },
          "uniqueItems": true,
          "description": "Every requirement that controls this hazard (the union of control_req_ids); the field tools/traceability.py cross-checks against hazard_ids in the requirements (HAZARD_INVERSE, HAZARD_UNRESOLVED)"
        },
        "residual_risk": {
          "$ref": "#/definitions/assessment"
        },
        "verification_note": {
          "type": "string",
          "minLength": 60,
          "description": "The evidence class that closes or supports each control (Simulation, HostUnit, Emulation, Inspection, Bench, OnAir; charter section 9; Emulation for event ordering only); the verification method (Test, Analysis, Inspection, Demonstration) stays in the requirement and is named here only where it is an accepted exception; software controls close by Test (SWE-192)"
        },
        "single_point_failures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 20
          },
          "description": "Single point failure candidates among the controls (01 section 4 row 15, PDR row 11); empty when none"
        },
        "fault_tolerance": {
          "type": "string",
          "minLength": 20,
          "description": "Fault tolerance achieved against the hazard with the controls in place"
        },
        "status": {
          "$ref": "#/definitions/status"
        },
        "related_risk_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^RSK-[0-9]{3}$"
          },
          "description": "Risks in docs/risk/register.json carrying this hazard under the hazard link rule (06 section 1); empty means a register entry is still needed"
        },
        "stakeholder_input_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SI-[0-9]{3}$"
          }
        },
        "decisions_pending": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10
          },
          "description": "Owner decisions the hazard's controls depend on, by the research decision ids where they exist"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          },
          "description": "Research reports (docs/research/<file>.md F<n>), regulatory clauses (47 CFR ..., eCFR 2026-09-23), process documents"
        },
        "history": {
          "type": "array",
