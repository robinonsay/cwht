    "history_entry": {
      "type": "object",
      "required": [
        "date",
        "review",
        "severity",
        "likelihood",
        "risk",
        "status",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/definitions/date"
        },
        "review": {
          "$ref": "#/definitions/review_point"
        },
        "severity": {
          "$ref": "#/definitions/severity"
        },
        "likelihood": {
          "$ref": "#/definitions/likelihood"
        },
        "risk": {
          "$ref": "#/definitions/risk_level"
        },
